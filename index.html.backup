<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InvestFacil - Analisador de Acoes B3</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 40px;
        }
        
        h1 {
            color: #333;
            margin-bottom: 10px;
            font-size: 2.5em;
        }
        
        .subtitle {
            color: #666;
            margin-bottom: 30px;
            font-size: 1.1em;
        }
        
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
        }
        
        .stat-card h3 {
            font-size: 2em;
            margin-bottom: 5px;
        }
        
        .stat-card p {
            opacity: 0.9;
        }
        
        .filters {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
        }
        
        .filter-group {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }
        
        .filter-item label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #333;
        }
        
        .filter-item input, .filter-item select {
            width: 100%;
            padding: 10px;
            border: 2px solid #ddd;
            border-radius: 5px;
            font-size: 1em;
        }
        
        .filter-item input:focus, .filter-item select:focus {
            outline: none;
            border-color: #667eea;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        
        th {
            background: #667eea;
            color: white;
            padding: 15px;
            text-align: left;
            font-weight: 600;
        }
        
        td {
            padding: 15px;
            border-bottom: 1px solid #eee;
        }
        
        tr:hover {
            background: #f8f9fa;
        }
        
        .positive {
            color: #28a745;
            font-weight: 600;
        }
        
        .negative {
            color: #dc3545;
            font-weight: 600;
        }
        
        .loading {
            text-align: center;
            padding: 40px;
            color: #666;
        }
        
        .error {
            background: #f8d7da;
            color: #721c24;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }
        
        .ticker {
            font-weight: bold;
            color: #667eea;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>InvestFacil</h1>
        <p class="subtitle">Analisador de Acoes da B3 - Escolha seus proprios criterios</p>
        
        <div id="error" class="error" style="display: none;"></div>
        
        <div class="stats">
            <div class="stat-card">
                <h3 id="total-acoes">-</h3>
                <p>Total de Acoes</p>
            </div>
            <div class="stat-card">
                <h3 id="media-dy">-</h3>
                <p>Dividend Yield Medio</p>
            </div>
            <div class="stat-card">
                <h3 id="media-pl">-</h3>
                <p>P/L Medio</p>
            </div>
            <div class="stat-card">
                <h3 id="ultima-atualizacao">-</h3>
                <p>Ultima Atualizacao</p>
            </div>
        </div>
        
        <div class="filters">
            <h2 style="margin-bottom: 15px;">Filtros</h2>
            <div class="filter-group">
                <div class="filter-item">
                    <label>Buscar Ticker:</label>
                    <input type="text" id="filter-ticker" placeholder="Ex: PETR4, VALE3...">
                </div>
                <div class="filter-item">
                    <label>Setor:</label>
                    <select id="filter-setor">
                        <option value="">Todos</option>
                    </select>
                </div>
                <div class="filter-item">
                    <label>Dividend Yield Minimo (%):</label>
                    <input type="number" id="filter-dy" placeholder="Ex: 5" step="0.1">
                </div>
                <div class="filter-item">
                    <label>P/L Maximo:</label>
                    <input type="number" id="filter-pl" placeholder="Ex: 15" step="0.1">
                </div>
            </div>
        </div>
        
        <div id="loading" class="loading">Carregando dados...</div>
        
        <div id="results" style="display: none;">
            <h2>Resultados (<span id="count-results">0</span> acoes)</h2>
            <table>
                <thead>
                    <tr>
                        <th>Ticker</th>
                        <th>Nome</th>
                        <th>Setor</th>
                        <th>Preco</th>
                        <th>DY (%)</th>
                        <th>P/L</th>
                        <th>Beta</th>
                        <th>Volume Medio</th>
                    </tr>
                </thead>
                <tbody id="table-body">
                </tbody>
            </table>
        </div>
    </div>
    
    <script>
        let acoesData = [];
        let metadata = {};
        
        // Carregar dados ao iniciar
        async function carregarDados() {
            try {
                // Carregar indicadores
                const respIndicadores = await fetch('indicadores.json');
                acoesData = await respIndicadores.json();
                
                // Carregar metadata
                const respMetadata = await fetch('metadata.json');
                metadata = await respMetadata.json();
                
                // Atualizar estatisticas
                atualizarEstatisticas();
                
                // Popular filtro de setores
                popularSetores();
                
                // Mostrar resultados
                aplicarFiltros();
                
                document.getElementById('loading').style.display = 'none';
                document.getElementById('results').style.display = 'block';
                
            } catch (error) {
                document.getElementById('loading').style.display = 'none';
                document.getElementById('error').style.display = 'block';
                document.getElementById('error').textContent = 'Erro ao carregar dados: ' + error.message;
            }
        }
        
        function atualizarEstatisticas() {
            document.getElementById('total-acoes').textContent = acoesData.length;
            
            // Calcular media de DY
            const acoesComDY = acoesData.filter(a => a.dividend_yield && a.dividend_yield > 0);
            const mediaDY = acoesComDY.length > 0 
                ? (acoesComDY.reduce((sum, a) => sum + a.dividend_yield, 0) / acoesComDY.length * 100).toFixed(2) 
                : '0.00';
            document.getElementById('media-dy').textContent = mediaDY + '%';
            
            // Calcular media de P/L
            const acoesComPL = acoesData.filter(a => a.preco_lucro_pl && a.preco_lucro_pl > 0);
            const mediaPL = acoesComPL.length > 0 
                ? (acoesComPL.reduce((sum, a) => sum + a.preco_lucro_pl, 0) / acoesComPL.length).toFixed(2) 
                : '0.00';
            document.getElementById('media-pl').textContent = mediaPL;
            
            // Data de atualizacao
            if (metadata.ultima_atualizacao) {
                const data = new Date(metadata.ultima_atualizacao);
                document.getElementById('ultima-atualizacao').textContent = 
                    data.toLocaleDateString('pt-BR');
            }
        }
        
        function popularSetores() {
            const setores = [...new Set(acoesData.map(a => a.setor).filter(s => s))];
            setores.sort();
            
            const select = document.getElementById('filter-setor');
            setores.forEach(setor => {
                const option = document.createElement('option');
                option.value = setor;
                option.textContent = setor;
                select.appendChild(option);
            });
        }
        
        function aplicarFiltros() {
            const ticker = document.getElementById('filter-ticker').value.toUpperCase();
            const setor = document.getElementById('filter-setor').value;
            const minDY = parseFloat(document.getElementById('filter-dy').value) || 0;
            const maxPL = parseFloat(document.getElementById('filter-pl').value) || Infinity;
            
            let resultados = acoesData.filter(acao => {
                // Filtro de ticker
                if (ticker && !acao.ticker.includes(ticker)) return false;
                
                // Filtro de setor
                if (setor && acao.setor !== setor) return false;
                
                // Filtro de DY
                const dy = (acao.dividend_yield || 0) * 100;
                if (dy < minDY) return false;
                
                // Filtro de P/L
                const pl = acao.preco_lucro_pl || 0;
                if (pl > maxPL || pl <= 0) return false;
                
                return true;
            });
            
            // Ordenar por DY decrescente
            resultados.sort((a, b) => (b.dividend_yield || 0) - (a.dividend_yield || 0));
            
            exibirResultados(resultados);
        }
        
        function exibirResultados(acoes) {
            const tbody = document.getElementById('table-body');
            tbody.innerHTML = '';
            
            document.getElementById('count-results').textContent = acoes.length;
            
            acoes.forEach(acao => {
                const row = tbody.insertRow();
                
                row.innerHTML = `
                    <td class="ticker">${acao.ticker}</td>
                    <td>${acao.nome_curto || '-'}</td>
                    <td>${acao.setor || '-'}</td>
                    <td>R$ ${(acao.preco_atual || 0).toFixed(2)}</td>
                    <td>${((acao.dividend_yield || 0) * 100).toFixed(2)}%</td>
                    <td>${(acao.preco_lucro_pl || 0).toFixed(2)}</td>
                    <td>${(acao.beta || 0).toFixed(2)}</td>
                    <td>${formatarNumero(acao.volume_medio || 0)}</td>
                `;
            });
        }
        
        function formatarNumero(num) {
            if (num >= 1000000) {
                return (num / 1000000).toFixed(1) + 'M';
            } else if (num >= 1000) {
                return (num / 1000).toFixed(1) + 'K';
            }
            return num.toFixed(0);
        }
        
        // Adicionar eventos aos filtros
        document.getElementById('filter-ticker').addEventListener('input', aplicarFiltros);
        document.getElementById('filter-setor').addEventListener('change', aplicarFiltros);
        document.getElementById('filter-dy').addEventListener('input', aplicarFiltros);
        document.getElementById('filter-pl').addEventListener('input', aplicarFiltros);
        
        // Iniciar aplicacao
        carregarDados();
    </script>
</body>
</html>
